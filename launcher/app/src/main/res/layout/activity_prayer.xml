<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#090E18"
    android:paddingStart="32dp"
    android:paddingEnd="32dp"
    android:paddingTop="22dp"
    android:paddingBottom="18dp"
    android:clipChildren="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.35"
        android:orientation="horizontal"
        android:clipChildren="false">

        <FrameLayout
            android:id="@+id/prayerHeroFrame"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.05"
            android:layout_marginEnd="22dp">

            <ImageView
                android:id="@+id/prayerHeroImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/islam_putra" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/prayer_hero_scrim" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/prayerHeroCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#E6FFFFFF"
                    android:textSize="13sp"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 600"
                    android:letterSpacing="0.08"
                    android:textAllCaps="true" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.15"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:clipChildren="false">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/prayerLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#94A3B8"
                    android:textSize="13sp"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 600"
                    android:letterSpacing="0.1"
                    android:textAllCaps="true"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/btnChangeZone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:background="@drawable/bg_location_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 600"
                    android:text="Tukar zon"
                    android:textColor="#CBD5E1"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/prayerHijri"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500"
                android:singleLine="true" />

            <TextView
                android:id="@+id/prayerNextLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="SOLAT SETERUSNYA"
                android:textColor="#4ADE80"
                android:textSize="12sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 700"
                android:letterSpacing="0.14" />

            <TextView
                android:id="@+id/prayerNextName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF"
                android:textSize="42sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 700"
                android:includeFontPadding="false"
                android:singleLine="true" />

            <TextView
                android:id="@+id/prayerNextTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#E6FFFFFF"
                android:textSize="22sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 600"
                android:includeFontPadding="false"
                android:singleLine="true" />

            <TextView
                android:id="@+id/prayerCountdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#94A3B8"
                android:textSize="14sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500"
                android:singleLine="true" />

            <ProgressBar
                android:id="@+id/prayerProgress"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="12dp"
                android:max="1000"
                android:progress="400"
                android:progressDrawable="@drawable/prayer_progress" />

            <LinearLayout
                android:id="@+id/prayerSlots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:clipChildren="false" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:clipChildren="false">

        <LinearLayout
            android:id="@+id/cardTazkirah"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:background="@drawable/weather_card_bg"
            android:orientation="vertical"
            android:padding="16dp"
            android:focusable="true"
            android:clickable="true">

            <TextView
                android:id="@+id/tazkirahLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TAZKIRAH"
                android:textColor="#4ADE80"
                android:textSize="11sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 700"
                android:letterSpacing="0.12" />

            <TextView
                android:id="@+id/tazkirahText"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="8dp"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500"
                android:lineSpacingExtra="3dp" />

            <TextView
                android:id="@+id/tazkirahSource"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500"
                android:singleLine="true" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardAyat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.15"
            android:layout_marginEnd="10dp"
            android:background="@drawable/weather_card_bg"
            android:orientation="vertical"
            android:padding="16dp"
            android:focusable="true"
            android:clickable="true">

            <TextView
                android:id="@+id/ayatCardRef"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#4ADE80"
                android:textSize="11sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 700"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/ayatCardArabic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp"
                android:gravity="end"
                android:textDirection="rtl"
                android:lineSpacingExtra="4dp" />

            <TextView
                android:id="@+id/ayatCardTranslation"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="8dp"
                android:textColor="#CBD5E1"
                android:textSize="13sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 400"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardQuote"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/weather_card_bg"
            android:orientation="vertical"
            android:padding="16dp"
            android:focusable="true"
            android:clickable="true">

            <TextView
                android:id="@+id/quoteLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QUOTE OF THE DAY"
                android:textColor="#4ADE80"
                android:textSize="11sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 700"
                android:letterSpacing="0.12" />

            <TextView
                android:id="@+id/quoteText"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="8dp"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500"
                android:lineSpacingExtra="3dp" />

            <TextView
                android:id="@+id/quoteSource"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

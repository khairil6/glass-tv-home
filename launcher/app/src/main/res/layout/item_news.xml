<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/news_item_bg"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/newsTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/outfit"
        android:fontVariationSettings="'wght' 700"
        android:includeFontPadding="false"
        android:letterSpacing="0.1"
        android:textAllCaps="true"
        android:textColor="#FBBF24"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/newsTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:fontFamily="@font/outfit"
        android:fontVariationSettings="'wght' 600"
        android:includeFontPadding="false"
        android:maxLines="3"
        android:textColor="#FFFFFFFF"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/newsMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:fontFamily="@font/outfit"
        android:fontVariationSettings="'wght' 500"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:textColor="#94A3B8"
        android:textSize="12sp" />
</LinearLayout>
